NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ftdcare_db
DB_USER=ftdcare_user
DB_PASSWORD=replace-with-a-secret
DB_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
ENABLE_DEV_PERSONAS=false
APP_URL=http://localhost:5173
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, and SMTP_FROM are optional.
# GEMINI_API_KEY is optional. The backend remains retrieval-only without it.
