{
  "name": "ftd-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=../config/ftdcare.env dist/server.js",
    "migrate": "node --env-file=../config/ftdcare.env --loader tsx src/db/migrate.ts",
    "seed": "node --env-file=../config/ftdcare.env --loader tsx src/db/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
