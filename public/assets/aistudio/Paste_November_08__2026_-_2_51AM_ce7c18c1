#### 4.6 Auth Controller & Routes (`app/src/modules/auth/auth.routes.ts`)
```typescript
import { Router, Request, Response } from 'express';
import bcrypt from 'bcrypt';
import jwt from 'jsonwebtoken';
import { z } from 'zod';
import { query } from '../../config/db.js';
import { authenticateToken } from '../../middleware/auth.js';

const router = Router();

const registerSchema = z.object({
  email: z.string().email(),
  password: z.string().min(8),
  fullName: z.string().min(2),
  role: z.enum(['care_partner', 'clinician']).default('care_partner'),
  specialty: z.string().optional(),
});

const loginSchema = z.object({
  email: z.string().email(),
  password: z.string(),
});

router.post('/register', async (req: Request, res: Response): Promise<void> => {
  const parseResult = registerSchema.safeParse(req.body);
  if (!parseResult.success) {
    res.status(400).json({ error: parseResult.error.errors[0].message });
    return;
  }

  const { email, password, fullName, role, specialty } = parseResult.data;

  const existing = await query('SELECT id FROM users WHERE email = $1', [email]);
  if (existing.rowCount && existing.rowCount > 0) {
    res.status(409).json({ error: 'Email already registered' });
    return;
  }

  const passwordHash = await bcrypt.hash(password, 12);
  const result = await query(
    `INSERT INTO users (email, password_hash, full_name, role, specialty)
     VALUES ($1, $2, $3, $4, $5)
     RETURNING id, email, full_name, role, specialty, created_at`,
    [email, passwordHash, fullName, role, specialty || null]
  );

  const newUser = result.rows[0];
  const token = jwt.sign(
    { id: newUser.id, email: newUser.email, role: newUser.role },
    process.env.JWT_SECRET!,
    { expiresIn: '7d' }
  );

  res.status(201).json({ user: newUser, token });
});

router.post('/login', async (req: Request, res: Response): Promise<void> => {
  const parseResult = loginSchema.safeParse(req.body);
  if (!parseResult.success) {
    res.status(400).json({ error: 'Invalid email or password format' });
    return;
  }

  const { email, password } = parseResult.data;
  const userResult = await query(
    `SELECT id, email, password_hash, full_name, role, specialty, is_verified 
     FROM users WHERE email = $1`,
    [email]
  );

  if (userResult.rowCount === 0) {
    res.status(401).json({ error: 'Invalid email or password' });
    return;
  }

  const user = userResult.rows[0];
  const isValid = await bcrypt.compare(password, user.password_hash);
  if (!isValid) {
    res.status(401).json({ error: 'Invalid email or password' });
    return;
  }

  const token = jwt.sign(
    { id: user.id, email: user.email, role: user.role },
    process.env.JWT_SECRET!,
    { expiresIn: '7d' }
  );

  delete user.password_hash;
  res.json({ user, token });
});

router.get('/me', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  const result = await query(
    `SELECT id, email, full_name, role, specialty, is_verified, avatar_url, bio, created_at 
     FROM users WHERE id = $1`,
    [req.user!.id]
  );
  if (result.rowCount === 0) {
    res.status(404).json({ error: 'User not found' });
    return;
  }
  res.json({ user: result.rows[0] });
});

export default router;
```

#### 4.7 Posts & Clinician Moderation Routes (`app/src/modules/posts/posts.routes.ts`)
```typescript
import { Router, Request, Response } from 'express';
import { z } from 'zod';
import { query } from '../../config/db.js';
import { authenticateToken, requireRole } from '../../middleware/auth.js';

const router = Router();

const createPostSchema = z.object({
  title: z.string().min(5),
  content: z.string().min(10),
  category: z.string(),
  cohortId: z.string().uuid().optional(),
  tags: z.array(z.string()).optional(),
});

// GET /api/posts - Feed with optional category filter
router.get('/', async (req: Request, res: Response): Promise<void> => {
  const { category, cohortId } = req.query;
  let sql = `
    SELECT p.*, u.full_name as author_name, u.role as author_role, u.is_verified as author_verified,
           (SELECT COUNT(*) FROM post_replies r WHERE r.post_id = p.id)::int as reply_count
    FROM posts p
    JOIN users u ON p.author_id = u.id
    WHERE 1=1
  `;
  const params: any[] = [];

  if (category) {
    params.push(category);
    sql += ` AND p.category = $${params.length}`;
  }
  if (cohortId) {
    params.push(cohortId);
    sql += ` AND p.cohort_id = $${params.length}`;
  }

  sql += ' ORDER BY p.is_pinned DESC, p.created_at DESC LIMIT 50';

  const result = await query(sql, params);
  res.json({ posts: result.rows });
});

// POST /api/posts - Create a discussion post
router.post('/', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  const parsed = createPostSchema.safeParse(req.body);
  if (!parsed.success) {
    res.status(400).json({ error: parsed.error.errors[0].message });
    return;
  }

  const { title, content, category, cohortId, tags } = parsed.data;
  const result = await query(
    `INSERT INTO posts (author_id, cohort_id, title, content, category, tags)
     VALUES ($1, $2, $3, $4, $5, $6)
     RETURNING *`,
    [req.user!.id, cohortId || null, title, content, category, tags || []]
  );

  res.status(201).json({ post: result.rows[0] });
});

// PATCH /api/posts/:id/verify - Clinician endorsement
router.patch('/:id/verify', authenticateToken, requireRole(['clinician', 'admin']), async (req: Request, res: Response): Promise<void> => {
  const { id } = req.params;
  const result = await query(
    `UPDATE posts 
     SET clinician_reviewed = TRUE, reviewed_by = $1, updated_at = NOW()
     WHERE id = $2 RETURNING *`,
    [req.user!.id, id]
  );

  if (result.rowCount === 0) {
    res.status(404).json({ error: 'Post not found' });
    return;
  }

  res.json({ post: result.rows[0], message: 'Clinician guidance applied' });
});

export default router;
```

#### 4.8 Private Clinician Messaging Routes (`app/src/modules/messages/messages.routes.ts`)
```typescript
import { Router, Request, Response } from 'express';
import { z } from 'zod';
import { query } from '../../config/db.js';
import { authenticateToken } from '../../middleware/auth.js';

const router = Router();

// GET /api/messages/conversations - List conversations for user
router.get('/conversations', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  const userId = req.user!.id;
  const result = await query(
    `SELECT c.*, 
            cp.full_name as care_partner_name,
            cl.full_name as clinician_name,
            (SELECT body FROM private_messages m WHERE m.conversation_id = c.id ORDER BY created_at DESC LIMIT 1) as last_message,
            (SELECT created_at FROM private_messages m WHERE m.conversation_id = c.id ORDER BY created_at DESC LIMIT 1) as last_message_at
     FROM private_conversations c
     JOIN users cp ON c.care_partner_id = cp.id
     JOIN users cl ON c.clinician_id = cl.id
     WHERE c.care_partner_id = $1 OR c.clinician_id = $1
     ORDER BY c.updated_at DESC`,
    [userId]
  );

  res.json({ conversations: result.rows });
});

// POST /api/messages/conversations - Start consultation with clinician (e.g., Dr. Seema Gulyani)
router.post('/conversations', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  const schema = z.object({
    clinicianId: z.string().uuid(),
    subject: z.string().min(3),
    initialMessage: z.string().min(5),
  });

  const parsed = schema.safeParse(req.body);
  if (!parsed.success) {
    res.status(400).json({ error: parsed.error.errors[0].message });
    return;
  }

  const { clinicianId, subject, initialMessage } = parsed.data;

  // Insert conversation & initial message in transaction
  const client = await (await import('../../config/db.js')).pool.connect();
  try {
    await client.query('BEGIN');
    const convResult = await client.query(
      `INSERT INTO private_conversations (care_partner_id, clinician_id, subject)
       VALUES ($1, $2, $3) RETURNING id`,
      [req.user!.id, clinicianId, subject]
    );

    const convId = convResult.rows[0].id;
    await client.query(
      `INSERT INTO private_messages (conversation_id, sender_id, body)
       VALUES ($1, $2, $3)`,
      [convId, req.user!.id, initialMessage]
    );

    await client.query('COMMIT');
    res.status(201).json({ conversationId: convId });
  } catch (err) {
    await client.query('ROLLBACK');
    throw err;
  } finally {
    client.release();
  }
});

export default router;
```

#### 4.9 Main Server Entrypoint (`app/src/server.ts`)
```typescript
import express from 'express';
import helmet from 'helmet';
import cors from 'cors';
import rateLimit from 'express-rate-limit';
import { pool } from './config/db.js';
import authRoutes from './modules/auth/auth.routes.js';
import postRoutes from './modules/posts/posts.routes.js';
import messageRoutes from './modules/messages/messages.routes.js';
import { errorHandler } from './middleware/errorHandler.js';

const app = express();
const PORT = process.env.PORT || 5000;

// Security Middlewares
app.use(helmet());
app.use(
  cors({
    origin: process.env.CORS_ORIGIN || '*',
    credentials: true,
  })
);

// Body parser
app.use(express.json({ limit: '1mb' }));
app.use(express.urlencoded({ extended: true }));

// Global Rate Limiting (100 req / 15 min per IP)
const limiter = rateLimit({
  windowMs: 15 * 60 * 1000,
  max: 100,
  standardHeaders: true,
  legacyHeaders: false,
});
app.use('/api', limiter);

// Health check endpoint
app.get('/api/health', async (_req, res) => {
  try {
    await pool.query('SELECT 1');
    res.json({ status: 'ok', nodeVersion: process.version, database: 'connected' });
  } catch (err: any) {
    res.status(503).json({ status: 'unhealthy', error: err.message });
  }
});

// API Routes
app.use('/api/auth', authRoutes);
app.use('/api/posts', postRoutes);
app.use('/api/messages', messageRoutes);

// Centralized error handling
app.use(errorHandler);

// Start server
const server = app.listen(PORT, () => {
  console.log(`[FTD Care Backend] Running on http://127.0.0.1:${PORT} (Node ${process.version})`);
});

// Graceful Shutdown
const shutdown = async () => {
  console.log('\n[FTD Care Backend] Shutting down gracefully...');
  server.close(async () => {
    await pool.end();
    console.log('[FTD Care Backend] Database pool closed.');
    process.exit(0);
  });
};

process.on('SIGTERM', shutdown);
process.on('SIGINT', shutdown);
```

#### 4.10 Migration Script (`app/src/db/migrate.ts`)
```typescript
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import { pool } from '../config/db.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

async function runMigration() {
  const sqlPath = path.join(__dirname, 'schema.sql');
  const sql = fs.readFileSync(sqlPath, 'utf-8');

  console.log('[Migration] Running database schema migration...');
  const client = await pool.connect();
  try {
    await client.query('BEGIN');
    await client.query(sql);
    await client.query('COMMIT');
    console.log('[Migration] Schema applied successfully.');
  } catch (err) {
    await client.query('ROLLBACK');
    console.error('[Migration Error]', err);
    process.exit(1);
  } finally {
    client.release();
    await pool.end();
  }
}

runMigration();
```

