{
  "name": "hopkins-care-partner-connect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix app run dev",
    "backend:migrate": "npm --prefix app run migrate",
    "backend:seed": "npm --prefix app run seed",
    "backend:test": "npm --prefix app test",
    "build": "npm run typecheck && vite build && npm --prefix app run build",
    "preview": "vite preview",
    "start": "npm --prefix app start",
    "clean": "rm -rf dist app/dist",
    "test": "vitest run",
    "lint": "eslint src app/src",
    "lint:eslint": "eslint src app/src",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "release:package": "npm run verify && npm run build && node scripts/package-release.mjs",
    "test:release": "node --test scripts/tests/*.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:release",
    "test:list": "vitest list --filesOnly"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
