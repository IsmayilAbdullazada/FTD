NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ftdcare_db
DB_USER=ftdcare_user
DB_PASSWORD=replace-with-a-secret
DB_SSL=false
TRUST_PROXY_HOPS=1
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
SESSION_COOKIE_MAX_AGE_MS=28800000
CORS_ORIGIN=http://localhost:5173
ENABLE_DEV_PERSONAS=false
ENABLE_DATABASE_RESET=false
ALLOW_PRODUCTION_SEED=false
APP_URL=http://localhost:5173
# SMTP relay configuration (no SMTP authentication; TLS is required).
# SMTP_HOST=mail.example.org
# SMTP_PORT=587
# SMTP_FROM=Care Partner Connect <no-reply@example.org>
# The relay must permit this server to send mail.
# GEMINI_API_KEY is optional. The backend remains retrieval-only without it.

# Opt-in for redacted local email metadata previews; forbidden in production.
ENABLE_DEV_AUTH_PREVIEWS=false

# Absolute persistent path for uploaded PDFs; default public/uploads/guides.
# GUIDE_UPLOAD_DIRECTORY=/var/lib/ftdcare/guides
