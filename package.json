{
  "name": "hopkins-care-partner-connect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix app run dev",
    "backend:migrate": "npm --prefix app run migrate",
    "backend:seed": "npm --prefix app run seed",
    "backend:test": "npm --prefix app test",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm --prefix app start",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint:eslint": "eslint src app/src",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
