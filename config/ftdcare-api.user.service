# Copy to ~/.config/systemd/user/ftdcare-api.service after adapting paths.
# Create ~/logs first. Keep PORT=3003 in the private production environment.
[Unit]
Description=Hopkins Care Partner API
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/hopkinscarepartners.eng.jhu.edu/app
ExecStart=/home/ftdcareweb/node/bin/node --env-file=/var/www/hopkinscarepartners.eng.jhu.edu/config/ftdcare.env dist/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
StandardOutput=append:%h/logs/api.log
StandardError=append:%h/logs/api.log

[Install]
WantedBy=default.target
